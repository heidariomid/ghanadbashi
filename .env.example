# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres connection string (phase 1)
DATABASE_URI=

# Payload signing secret — any long random string (phase 1)
PAYLOAD_SECRET=

# Public origin, used for absolute URLs and the admin
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Added in later phases:
# BLOB_READ_WRITE_TOKEN=   # Vercel Blob, for client-uploaded photos (phase 2)
# RESEND_API_KEY=          # order notification emails (phase 5)
