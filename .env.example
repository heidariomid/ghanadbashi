# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres connection string (phase 1)
DATABASE_URI=

# Payload signing secret — generate with: openssl rand -base64 48 (phase 1)
PAYLOAD_SECRET=

# Public origin, used for absolute URLs and the admin.
# Local only — on Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL,
# so do not set it there unless you need to override the detected domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Added in later phases:
# BLOB_READ_WRITE_TOKEN=   # Vercel Blob, for client-uploaded photos (phase 2)
# RESEND_API_KEY=          # order notification emails (phase 5)
