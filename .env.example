# Copy to .env and fill in. Never commit the real .env.

# Database — local dev (Postgres.app) vs production (Neon).
# Local: no VPN needed. Production URL goes in Vercel env vars only.
DATABASE_URI=postgresql://omid@localhost:5432/bakery

# Neon (production / one-off prod tasks). Do not use for daily dev.
# Used by `pnpm db:pull` to copy production data to local Postgres.
# NEON_DATABASE_URI=postgresql://...@...neon.tech/neondb?sslmode=require

# Payload signing secret — generate with: openssl rand -base64 48 (phase 1)
PAYLOAD_SECRET=

# Public origin, used for absolute URLs and the admin.
# Production: https://ghanadbashiasal.ir — set on Vercel so metadata and links
# use the custom domain (not the *.vercel.app URL).
NEXT_PUBLIC_SERVER_URL=https://ghanadbashiasal.ir/

# Added in later phases:
# BLOB_READ_WRITE_TOKEN=   # Vercel Blob, for client-uploaded photos (phase 2)

# Order notification email (phase 5). If any of these is missing, the order
# still saves and the customer still sees success.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# Order SMS (phase 10a). Local uses the Sandbox key — same URL, no SMS sent,
# no credit spent. Docs: https://app.sms.ir/developer/help/sandbox
# Sandbox only accepts templateId 123456 with parameter name Code.
# SMSIR_API_KEY=
# SMSIR_TEMPLATE_NEW_ORDER=123456
# SMSIR_TEMPLATE_ORDER_RECEIVED=123456
# SMSIR_TEMPLATE_CONFIRMED=123456
# SMSIR_TEMPLATE_DELIVERED=123456
# SMSIR_TEMPLATE_CANCELLED=123456
# SMSIR_TEMPLATE_OTP=123456
# SMSIR_TEMPLATE_DEPOSIT=123456        # بیعانه; params NAME, ORDER, AMOUNT, CARD, TOKEN
# OTP_DAILY_LIMIT=200
# OTP_REQUIRED=1                       # off unless set. Shows SMS code on /order
# ORDER_NOTIFICATION_PHONE=
